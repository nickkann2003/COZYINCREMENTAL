{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f5c7fba9e07d441ea7a762882a4ac832",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CustomVoronoi (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1626.0001220703125,
            "y": -297.0000305175781,
            "width": 241.0,
            "height": 326.0000305175781
        }
    },
    "m_Slots": [
        {
            "m_Id": "8982c18bef744ca785520c8fa4a52555"
        },
        {
            "m_Id": "568a9416a938491099c00698993c0e41"
        },
        {
            "m_Id": "14cdc780d9b4478eb45ef2eb6801d008"
        },
        {
            "m_Id": "b98b3c626a3d4e62b2e6df7eeae23a7e"
        },
        {
            "m_Id": "fc7fddb11bca413bba8c19a654a5f651"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 1,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CustomVoronoi",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 g = floor(UV * CellDensity);\nfloat2 f = frac(UV * CellDensity);\nfloat t = 8.0;\nfloat3 res = float3(8.0, 0.0, 0.0);\n\nfor(int y=-1; y<=1; y++) {\n    for(int x=-1; x<=1; x++) {\n        float2 lattice = float2(x, y);\n\n\tfloat2 sUV = lattice + g;\r\n        float2x2 m = float2x2(15.27, 47.63, 99.41, 89.98);\r\n        sUV = frac(sin(mul(sUV, m)) * 46839.32);\n\n\tfloat2 offset = float2(sin(sUV.y*+AngleOffset)*0.5+0.5, cos(sUV.x*AngleOffset)*0.5+0.5);\t\n\n        // Pseudo-random offset for the point in the cell\n        //float2 offset = float2(\n       //     frac(sin(dot(g + lattice, float2(127.1, 311.7))) * 43758.5453),\n        //    frac(sin(dot(g + lattice, float2(269.5, 183.3))) * 43758.5453)\n        //);\n        float2 p = lattice + offset - f;\n        float d = dot(p, p);\n\n        if(d < res.x) {\n            res.x = d;\n            // Store the absolute UV center of the closest cell\n            Center = (g + lattice + offset) / CellDensity;\n        }\n    }\n}\nOut = res.x;\n"
}

